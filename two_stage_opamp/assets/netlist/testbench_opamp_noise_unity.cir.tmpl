* Two-Stage Op Amp — Unity-Gain Closed-Loop Output Noise

VDD_SRC vdd 0 DC {vdd}
VINP_SRC inp 0 DC {vcm} AC 1

{dut_include}
XOP inp out out vdd 0 two_stage_opamp

CLOAD out 0 {cl}
RLEAK out 0 {r_leak}

.include {model_path}
.options RELTOL=1e-4 ABSTOL=1e-12 VNTOL=1e-7 ITL4=80

.control
noise V(out) VINP_SRC dec {noise_pts} {fstart} {fstop}
setplot noise1
wrdata {out_freq} frequency
wrdata {out_onoise} onoise_spectrum
wrdata {out_inoise} inoise_spectrum
.endc

.end
