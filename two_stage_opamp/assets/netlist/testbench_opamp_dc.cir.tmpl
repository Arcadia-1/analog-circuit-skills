* Two-Stage Op Amp — DC Operating Point

VDD_SRC vdd 0 DC {vdd}
VSS_SRC vss 0 DC 0
VINP_SRC inp 0 DC {vcm}
VINN_SRC inn 0 DC {vcm}

{dut_include}
XOP inp inn out vdd vss two_stage_opamp

CLOAD out vss {cl}
RLEAK out vss {r_leak}

.include {model_path}
.options RELTOL=1e-4 ABSTOL=1e-12 VNTOL=1e-7 ITL4=80

.control
op
wrdata {out_nodes} v(inp) v(inn) v(xop.c) v(xop.a) v(xop.b) v(out) v(xop.pbias)
wrdata {out_currents} i(VDD_SRC)
.endc

.end
