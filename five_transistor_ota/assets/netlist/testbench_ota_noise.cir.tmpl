* Five-Transistor OTA — Output Noise Testbench

VDD_SRC   vdd   0 DC {vdd}
VSS_SRC   vss   0 DC 0
VBIAS_SRC vbias 0 DC {vbias}
VINP_SRC  inp   0 DC {vcm} AC 1
VINN_SRC  inn   0 DC {vcm}

{dut_include}
XOTA inp inn out vdd vss vbias five_transistor_ota

RLOAD out vss {r_load}
CLOAD out vss {c_load}

.include {model_path}
.options RELTOL=1e-4 ABSTOL=1e-12 VNTOL=1e-7 ITL4=80

.control
noise V(out, vss) VINP_SRC dec {noise_pts} {fstart} {fstop}
setplot noise1
wrdata {out_freq} frequency
wrdata {out_onoise} onoise_spectrum
.endc

.end

